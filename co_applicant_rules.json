{
  "name": "co_applicant_rules",
  "description": "Co-applicant age eligibility (brother/sister) and income consideration (brother/father/mother/sister) rules (COAPP-###).",
  "constants": {
    "min_co_applicant_age": 21,
    "max_co_applicant_age": 65,
    "min_co_applicant_income": 15000
  },
  "rules": [
    {
      "id": "COAPP-601",
      "category": "Co-Applicant Age",
      "relation": "brother",
      "condition": "co_applicant.brother.age < constants.min_co_applicant_age || co_applicant.brother.age > constants.max_co_applicant_age",
      "result": {
        "status": "REJECT_COAPP",
        "reason": "Co-applicant (brother) does not meet age eligibility."
      }
    },
    {
      "id": "COAPP-602",
      "category": "Co-Applicant Age",
      "relation": "sister",
      "condition": "co_applicant.sister.age < constants.min_co_applicant_age || co_applicant.sister.age > constants.max_co_applicant_age",
      "result": {
        "status": "REJECT_COAPP",
        "reason": "Co-applicant (sister) does not meet age eligibility."
      }
    },
    {
      "id": "COAPP-603",
      "category": "Co-Applicant Income",
      "relation": "brother",
      "condition": "co_applicant.brother.income < constants.min_co_applicant_income",
      "result": {
        "status": "DISCOUNT_50PCT",
        "reason": "Brother's income counted at reduced weightage for FOIR computation."
      }
    },
    {
      "id": "COAPP-604",
      "category": "Co-Applicant Income",
      "relation": "father",
      "condition": "co_applicant.father.income < constants.min_co_applicant_income",
      "result": {
        "status": "DISCOUNT_50PCT",
        "reason": "Father's income counted at reduced weightage for FOIR computation."
      }
    },
    {
      "id": "COAPP-605",
      "category": "Co-Applicant Income",
      "relation": "mother",
      "condition": "co_applicant.mother.income < constants.min_co_applicant_income",
      "result": {
        "status": "DISCOUNT_50PCT",
        "reason": "Mother's income counted at reduced weightage for FOIR computation."
      }
    },
    {
      "id": "COAPP-606",
      "category": "Co-Applicant Income",
      "relation": "sister",
      "condition": "co_applicant.sister.income < constants.min_co_applicant_income",
      "result": {
        "status": "DISCOUNT_50PCT",
        "reason": "Sister's income counted at reduced weightage for FOIR computation."
      }
    }
  ]
}
