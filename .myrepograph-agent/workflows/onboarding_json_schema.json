{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlowBREOnboardingPayload",
  "description": "Unified JSON schema architecture for FlowBRE Onboarding Workflow supporting Individual, Company, and HUF entity channels with dynamic conditional validation.",
  "type": "object",
  "required": [
    "entityType",
    "selectedBank",
    "pincode",
    "cityName",
    "stateName",
    "residenceStatus",
    "bureauCibilScore",
    "bureauDpd",
    "bureauWriteOffAmount"
  ],
  "properties": {
    "entityType": {
      "type": "string",
      "enum": ["Individual", "Company", "HUF"],
      "description": "Primary onboarding channel category."
    },
    "selectedBank": {
      "type": "string",
      "enum": ["BOI", "INDIAN_BANK", "IOB", "BOB", "BOM", "HDFC", "AXIS", "KOTAK"],
      "description": "Target financing partner bank code."
    },
    "applicantName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Full name of the individual primary applicant."
    },
    "dob": {
      "type": "string",
      "format": "date",
      "description": "Date of birth (YYYY-MM-DD) triggering age evaluation."
    },
    "gender": {
      "type": "string",
      "enum": ["MALE", "FEMALE", "OTHER"]
    },
    "pan": {
      "type": "string",
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
      "description": "Individual 10-character PAN card number."
    },
    "maritalStatus": {
      "type": "string",
      "enum": ["MARRIED", "UNMARRIED"]
    },
    "citizenshipStatus": {
      "type": "string",
      "enum": ["RESIDENT_INDIAN", "NRI_PIO"]
    },
    "nriStayPeriod": {
      "type": "integer",
      "minimum": 0,
      "description": "Minimum in-country stay period in days for NRI/PIO applicants."
    },
    "phone": {
      "type": "string",
      "pattern": "^[6-9][0-9]{9}$",
      "description": "10-digit mobile number."
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "companyType": {
      "type": "string",
      "enum": ["Propreitorship", "Parternship Firm", "Private Limited", "Public Limited"],
      "description": "Legal entity structure for organization channel."
    },
    "companyPan": {
      "type": "string",
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$"
    },
    "udyamRegNoCompany": {
      "type": "string",
      "pattern": "^$|^UDYAM-[A-Z]{2}-[0-9]{2}-[0-9]{7}$"
    },
    "companyLocation": {
      "type": "string"
    },
    "contactPersonName": {
      "type": "string"
    },
    "contactPersonDesignation": {
      "type": "string"
    },
    "companyMobile": {
      "type": "string",
      "pattern": "^[6-9][0-9]{9}$"
    },
    "companyEmail": {
      "type": "string",
      "format": "email"
    },
    "companyEstablishmentDate": {
      "type": "string",
      "format": "date"
    },
    "companyItrFilingStatus": {
      "type": "string",
      "enum": ["Filed", "Not Filed"]
    },
    "companyCurrentITRAmount": {
      "type": "number",
      "minimum": 0
    },
    "companyPrevITRAmount": {
      "type": "number",
      "minimum": 0
    },
    "companyGstin": {
      "type": "string",
      "pattern": "^$|^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"
    },
    "hufName": {
      "type": "string"
    },
    "hufPan": {
      "type": "string",
      "pattern": "^[A-Z]{4}H[0-9]{4}[A-Z]{1}$"
    },
    "udyamRegNoHUF": {
      "type": "string"
    },
    "hufLocation": {
      "type": "string"
    },
    "hufFormationDate": {
      "type": "string",
      "format": "date"
    },
    "kartaName": {
      "type": "string"
    },
    "kartaPan": {
      "type": "string",
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$"
    },
    "kartaMobile": {
      "type": "string",
      "pattern": "^[6-9][0-9]{9}$"
    },
    "pincode": {
      "type": "string",
      "pattern": "^[1-9][0-9]{5}$"
    },
    "cityName": {
      "type": "string"
    },
    "stateName": {
      "type": "string"
    },
    "residenceStatus": {
      "type": "string",
      "enum": [
        "Owned House",
        "Rented House",
        "Resi - Cum Office - One Owned",
        "Resi - Cum Office -Both Rented",
        "Resi-Office-Separate-Both Rented"
      ]
    },
    "guarantorStatus": {
      "type": "string",
      "enum": ["Provided", "Not Provided"]
    },
    "occupation": {
      "type": "string",
      "enum": ["Salaried", "Self-Employed"]
    },
    "employerType": {
      "type": "string",
      "enum": [
        "Employment-Pvt Ltd",
        "Employment-Public Ltd",
        "Employment-Govt",
        "Employment-PSU",
        "Employment-Firm",
        "Agriculture"
      ]
    },
    "tenureBand": {
      "type": "string",
      "enum": ["0-6m", "6m-1y", "1y-2y", "2y+"]
    },
    "prevCompanyName": {
      "type": "string"
    },
    "prevCompanyJoining": {
      "type": "string",
      "format": "date"
    },
    "grossSalaryBand": {
      "type": "string",
      "enum": ["lt25000", "gt25000"]
    },
    "salaryMode": {
      "type": "string",
      "enum": ["Salary payment mode- Bank Credit", "Salary payment mode-Cash"]
    },
    "form16Status": {
      "type": "string",
      "enum": ["Form 16", "No Income Proof"]
    },
    "rentalIncomeTypeSalaried": {
      "type": "string",
      "enum": [
        "None",
        "Rental Income-with Agreement -Not filed ITR-Not reflecting in Bank",
        "Rental Income-with Agreement filed ITR- Not reflecting in Bank",
        "Rental Income-with Agreement -Not filed ITR-reflecting in Bank"
      ]
    },
    "officeAddressType": {
      "type": "string",
      "enum": ["Same", "Separate"]
    },
    "officeAddress": {
      "type": "string"
    },
    "businessEntityType": {
      "type": "string",
      "enum": [
        "Propreitorship",
        "Parternship Firm",
        "Private Limited",
        "Public Limited",
        "HUF"
      ]
    },
    "udyamRegNoSelfEmployed": {
      "type": "string"
    },
    "businessEstablishmentDate": {
      "type": "string",
      "format": "date"
    },
    "itrFilingStatus": {
      "type": "string",
      "enum": ["Self employed ITR Filled", "ITR Not Filed"]
    },
    "currentITRAmount": {
      "type": "number",
      "minimum": 0
    },
    "prevITRAmount": {
      "type": "number",
      "minimum": 0
    },
    "rentalIncomeTypeSelfEmployed": {
      "type": "string",
      "enum": [
        "None",
        "Rental Income-with Agreement -Not filed ITR-Not reflecting in Bank",
        "Rental Income-with Agreement filed ITR- Not reflecting in Bank",
        "Rental Income-with Agreement -Not filed ITR-reflecting in Bank"
      ]
    },
    "businessProof": {
      "type": "string"
    },
    "bureauCibilScore": {
      "type": "integer",
      "minimum": 300,
      "maximum": 900
    },
    "bureauDpd": {
      "type": "integer",
      "minimum": 0
    },
    "bureauWriteOffAmount": {
      "type": "number",
      "minimum": 0
    },
    "bureauFlagPL": {
      "type": "boolean"
    },
    "bureauFlagHome": {
      "type": "boolean"
    },
    "bureauFlagConsumer": {
      "type": "boolean"
    },
    "coApplicantRelation": {
      "type": "string",
      "enum": ["None", "Brother", "Sister", "Father", "Mother", "Spouse"]
    },
    "coApplicantAge": {
      "type": "integer",
      "minimum": 18,
      "maximum": 80
    },
    "coApplicantIncome": {
      "type": "number",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entityType": { "const": "Individual" }
        }
      },
      "then": {
        "required": [
          "applicantName",
          "dob",
          "gender",
          "pan",
          "maritalStatus",
          "citizenshipStatus",
          "phone",
          "email",
          "occupation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "citizenshipStatus": { "const": "NRI_PIO" }
        }
      },
      "then": {
        "required": ["nriStayPeriod"]
      }
    },
    {
      "if": {
        "properties": {
          "entityType": { "const": "Company" }
        }
      },
      "then": {
        "required": [
          "companyType",
          "companyPan",
          "companyLocation",
          "contactPersonName",
          "contactPersonDesignation",
          "companyMobile",
          "companyEmail",
          "companyEstablishmentDate",
          "companyItrFilingStatus"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "entityType": { "const": "HUF" }
        }
      },
      "then": {
        "required": [
          "hufName",
          "hufPan",
          "hufLocation",
          "hufFormationDate",
          "kartaName",
          "kartaPan",
          "kartaMobile",
          "occupation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "occupation": { "const": "Salaried" }
        }
      },
      "then": {
        "required": [
          "employerType",
          "tenureBand",
          "grossSalaryBand",
          "salaryMode",
          "form16Status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tenureBand": { "enum": ["0-6m", "6m-1y", "1y-2y"] }
        }
      },
      "then": {
        "required": ["prevCompanyName", "prevCompanyJoining"]
      }
    },
    {
      "if": {
        "properties": {
          "occupation": { "const": "Self-Employed" }
        }
      },
      "then": {
        "required": [
          "businessEntityType",
          "businessEstablishmentDate",
          "itrFilingStatus"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "itrFilingStatus": { "const": "Self employed ITR Filled" }
        }
      },
      "then": {
        "required": ["currentITRAmount", "prevITRAmount"]
      }
    },
    {
      "if": {
        "properties": {
          "residenceStatus": {
            "enum": [
              "Resi - Cum Office -Both Rented",
              "Resi-Office-Separate-Both Rented"
            ]
          }
        }
      },
      "then": {
        "required": ["guarantorStatus"]
      }
    }
  ]
}
