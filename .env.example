PROJECT_NAME="FlowBRE Onboarding BRE Engine"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Settings
# HOST-FACING values: where a process on this machine reaches the service.
# docker-compose publishes Postgres on POSTGRES_PORT and overrides the pair
# below to postgres:5432 inside the container, so ONE file serves both:
#   local  ->  localhost:5435   (published port)
#   docker ->  postgres:5432    (compose environment: block)
# Change POSTGRES_PORT and the published port follows it automatically.
POSTGRES_SERVER=localhost
POSTGRES_USER=bre_user
POSTGRES_PASSWORD=bre_password
POSTGRES_DB=bre_db
POSTGRES_PORT=5435
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Connection URIs (For local host tools / DBeaver / TablePlus)
# SQLAlchemy Async: postgresql+asyncpg://bre_user:bre_password@127.0.0.1:5435/bre_db
# Redis Connection: redis://127.0.0.1:6379/0

# Redis Settings — host-facing, same arrangement as Postgres above.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security Settings
SECRET_KEY=super-secret-jwt-key-flowbre-enterprise-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SLA Latency Thresholds (ms)
SLA_GET_LOOKUP_MS=30.0
SLA_CRUD_EVAL_MS=80.0
SLA_ZEN_RAM_EVAL_MS=10.0
