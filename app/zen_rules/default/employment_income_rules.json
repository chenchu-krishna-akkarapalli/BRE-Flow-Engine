{
  "name": "employment_income_rules",
  "description": "Salaried and self-employed employment, income, FOIR, rental income, ITR, and business entity rules (EMP-SAL-###, EMP-SE-###, ENT-5##)",
  "rules": [
    {
      "id": "EMP-SAL-201",
      "category": "Employment - Salaried",
      "condition": "occupation == 'SALARIED' && current_company_tenure_months < 24",
      "result": {
        "status": "REQUIRE_PREVIOUS_EMPLOYMENT_FIELDS",
        "reason": "Mandates previous_company_name and previous_joining_date."
      }
    },
    {
      "id": "EMP-SAL-202",
      "category": "Employment - Salaried",
      "condition": "occupation == 'SALARIED' && net_monthly_salary < 25000",
      "result": {
        "status": "REJECT",
        "reason": "Monthly net salary is below the minimum parameter (₹25,000)."
      }
    },
    {
      "id": "EMP-SAL-203",
      "category": "Employment - Salaried",
      "condition": "occupation == 'SALARIED' && salary_payment_mode == 'CASH'",
      "result": {
        "status": "REJECT_OR_MANUAL_AUDIT",
        "reason": "Cash salary requires secondary manual audit or is rejected per bank policy."
      }
    },
    {
      "id": "EMP-SAL-204",
      "category": "Employment - Salaried",
      "condition": "occupation == 'SALARIED' && minimum_work_experience_years < 1",
      "result": {
        "status": "REJECT",
        "reason": "Applicant does not meet minimum total work experience (1 year)."
      }
    },
    {
      "id": "EMP-SAL-205",
      "category": "Employment - Salaried",
      "condition": "occupation == 'SALARIED' && employer_type == 'PVT_LTD' && work_experience_current_company_months < 6",
      "result": {
        "status": "FLAG",
        "reason": "Short tenure at current private-sector employer — routed for manual review."
      }
    },
    {
      "id": "EMP-SAL-206",
      "category": "Employment - Salaried",
      "condition": "employer_type in ['GOVT', 'PSU', 'PUBLIC_LTD', 'PVT_LTD', 'FIRM', 'AGRICULTURE']",
      "result": {
        "status": "PASS",
        "reason": "Employer type accepted; used for risk weighting per bank."
      }
    },
    {
      "id": "EMP-SAL-207",
      "category": "Employment - Salaried",
      "condition": "form_16_available == false && no_income_proof_segment == true",
      "result": {
        "status": "FLAG",
        "reason": "No income proof — routed to alternate-income underwriting path."
      }
    },
    {
      "id": "EMP-SAL-301",
      "category": "Income & FOIR",
      "condition": "emi_income_ratio_foir > bank_policy.max_foir_ratio",
      "result": {
        "status": "REJECT",
        "reason": "EMI-to-income ratio (FOIR) exceeds the selected bank's maximum threshold."
      }
    },
    {
      "id": "EMP-SAL-302",
      "category": "Income & FOIR",
      "condition": "rental_income.agreement == true && rental_income.itr_filed == false && rental_income.bank_reflected == false",
      "result": {
        "status": "DISCOUNT_50PCT",
        "reason": "Rental income counted at reduced weightage due to no ITR/bank proof."
      }
    },
    {
      "id": "EMP-SAL-303",
      "category": "Income & FOIR",
      "condition": "rental_income.agreement == true && rental_income.itr_filed == true && rental_income.bank_reflected == false",
      "result": {
        "status": "DISCOUNT_25PCT",
        "reason": "Rental income counted at partial weightage (ITR filed, not bank-reflected)."
      }
    },
    {
      "id": "EMP-SAL-304",
      "category": "Income & FOIR",
      "condition": "rental_income.agreement == true && rental_income.itr_filed == false && rental_income.bank_reflected == true",
      "result": {
        "status": "DISCOUNT_25PCT",
        "reason": "Rental income counted at partial weightage (bank-reflected, ITR not filed)."
      }
    },
    {
      "id": "EMP-SE-301",
      "category": "Self-Employed",
      "condition": "occupation == 'SELF_EMPLOYED' && business_experience_years < 2",
      "result": {
        "status": "REJECT",
        "reason": "Minimum 2 years of business existence required."
      }
    },
    {
      "id": "EMP-SE-302",
      "category": "Self-Employed",
      "condition": "occupation == 'SELF_EMPLOYED' && current_itr < 300000",
      "result": {
        "status": "REJECT",
        "reason": "Current-year ITR must be at least ₹3,00,000."
      }
    },
    {
      "id": "EMP-SE-303",
      "category": "Self-Employed",
      "condition": "occupation == 'SELF_EMPLOYED' && previous_itr < 100000",
      "result": {
        "status": "REJECT",
        "reason": "Previous-year ITR must be at least ₹1,00,000."
      }
    },
    {
      "id": "EMP-SE-304",
      "category": "Self-Employed",
      "condition": "occupation == 'SELF_EMPLOYED' && itr_filed == false",
      "result": {
        "status": "REJECT",
        "reason": "Active ITR filing proof is required for self-employed profiles."
      }
    },
    {
      "id": "EMP-SE-305",
      "category": "Self-Employed",
      "condition": "occupation == 'SELF_EMPLOYED' && requested_loan_amount < 100000",
      "result": {
        "status": "REJECT",
        "reason": "Minimum loan ticket size for self-employed applicants is ₹1,00,000."
      }
    },
    {
      "id": "EMP-SE-306",
      "category": "Self-Employed",
      "condition": "business_entity_type in ['PROPRIETORSHIP', 'PARTNERSHIP', 'PVT_LTD', 'PUBLIC_LTD', 'HUF']",
      "result": {
        "status": "PASS",
        "reason": "Entity type accepted for documentation and risk-tier routing."
      }
    },
    {
      "id": "EMP-SE-307",
      "category": "Self-Employed",
      "condition": "occupation == 'SELF_EMPLOYED' && business_proof == false",
      "result": {
        "status": "REJECT",
        "reason": "Valid business proof/registration document is required."
      }
    },
    {
      "id": "ENT-502",
      "category": "Business Entity",
      "condition": "business_entity_type == 'HUF'",
      "result": {
        "status": "FLAG",
        "reason": "HUF entities require additional coparcener documentation."
      }
    },
    {
      "id": "ENT-505",
      "category": "Business Entity",
      "condition": "itr_filed == false",
      "result": {
        "status": "REJECT",
        "reason": "Mandatory ITR filing proof missing."
      }
    },
    {
      "id": "ENT-506",
      "category": "Business Entity",
      "condition": "business_itr_amount < bank_policy.min_business_itr_floor",
      "result": {
        "status": "REJECT",
        "reason": "Declared business ITR is below the bank's minimum acceptable value."
      }
    }
  ]
}
